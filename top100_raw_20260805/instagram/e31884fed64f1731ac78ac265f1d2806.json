 "is_bookmarked": false, "is_trending_in_clips": false, "should_mute_audio_reason": "", "should_mute_audio_reason_type": null, "inline_audio_label": null, "display_labels": null, "display_labels_with_translations": null, "user_notes": null}, "xpost_fb_creator_info": null, "fb_downstream_use_xpost_metadata": {"downstream_use_xpost_deny_reason": "NONE"}}, "originality_info": null, "reels_on_the_rise_info": null, "reusable_text_attribute_string": null, "reusable_text_info": null, "shopping_info": null, "show_achievements": false, "may_have_template_info": null, "viewer_interaction_settings": null, "template_info": null}, "like_count": 21530, "has_liked": false, "hidden_likes_string_variant": -1, "caption": {"strong_id__": "18610640629049484", "bit_flags": 0, "created_at": 1784876408, "created_at_utc": 1784876408, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "18610640629049484", "share_enabled": false, "content_type": "comment", "media_id": "3948152263168381409", "status": "Active", "type": 1, "user_id": "310386046", "text": "Presiden Prabowo Subianto mengatakan bahwa kelompok ‘londo ireng’ masih ada hingga saat ini dengan identitas yang berbeda. “Kita tahu ada orang-orang Indonesia yang senang mengabdi dan berbakti kepada bangsa lain. Itu yang dulu kita sebut ‘londo ireng’, yang ikut Belanda perang melawan kita. ‘Londo-londo ireng’ ini sampai sekarang masih ada, hanya pakai baju lain. Wartawan, pengamat, dan LSM harus kita tanya yang gaji lu siapa,” ucap Prabowo pada 23 Juli 2026.\n\nBaca selengkapnya di tempo.co dan link in bio.\n\n#tempodotco #TUpdate #Prabowo", "user": {"strong_id__": "310386046", "pk": "310386046", "pk_id": "310386046", "id": "310386046", "is_unpublished": false, "fbid_v2": "17841401501384849", "username": "tempodotco", "full_name": "tempo.co by Tempo Media Group", "is_private": false, "is_verified": true, "profile_pic_id": "3724210851730622579_310386046", "profile_pic_url": "https://scontent-bog2-1.cdninstagram.com/v/t51.82787-19/550411618_18530886049050047_529007314515339118_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby4xMDAyLmMyIn0&_nc_ht=scontent-bog2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gH1tMeBIqGbBWkumYjHfKUbYlwE8dxTA5DilDsFVZnUBglWJtKWQFindmYtlkZfODA&_nc_ohc=Xjk1WIY-likQ7kNvwHS56uP&_nc_gid=YDlaTZRNB6BYd-F8Z1XJmQ&edm=ACWDqb8BAAAA&ccb=7-5&oh=00_AQDxM-DFkOA_JDuhYjiq-Ec15hyokA-IcgfHDFKXIobaWQ&oe=6A6932FF&_nc_sid=ee9879"}, "is_covered": false, "private_reply_status": 0, "text_translation": "President Prabowo Subianto said that the group of ‘black dutch’ still exists to this day with different identities. \"We know there are Indonesian people who love to serve and devote to other nations. That's what we used to call the 'black Dutch' who joined the Netherlands in the war against us. These 'Black Dutch' still exist, just wear different clothes. Journalists, observers, and NGOs, we must ask whose salary is yours,\" Prabowo said on July 23, 2026.\n\nRead more at tempo.co and link in bio.\n\n #tempodotco #TUpdate #Prabowo"}, "comment_count": 5198, "comment_likes_enabled": true, "play_count": 446825, "ig_play_count": 446825, "shop_routing_user_id": null, "featured_products": [], "video_duration": 70.06999969482422, "is_dash_eligible": 1, "video_dash_manifest": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<MPD xmlns=\"urn:mpeg:dash:schema:mpd:2011\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xsi:schemaLocation=\"urn:mpeg:dash:schema:mpd:2011 DASH-MPD.xsd\" profiles=\"urn:mpeg:dash:profile:isoff-on-demand:2011\" minBufferTime=\"PT2S\" type=\"static\" mediaPresentationDuration=\"PT70.070068S\" FBManifestTimestamp=\"1784892953\" FBManifestIdentifier=\"FrK4mqYNGBFpZ19kYXNoX2Jhc2ljX3ZwORlW7uaViseZsAWQl/n+yJmwBbqKkILJmbAFjvG9iMmZsAW45NSLyZmwBSIYGGRhc2hfbG5faGVhYWNfdmJyM19hdWRpbyIsGRgObGF0YW1fbW9kZXJhdGUAFgAUABIUAgA=\"><Period id=\"0\" duration=\"PT70.070068S\"><AdaptationSet id=\"0\" contentType=\"video\" subsegmentAlignment=\"true\" par=\"9:16\" FBU