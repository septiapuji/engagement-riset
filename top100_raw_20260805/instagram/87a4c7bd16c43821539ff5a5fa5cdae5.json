1&_nc_oc=Q6cZ2gF3Md_jmxtlQkxXzXItrb4abOop4bd0bSj8wSu3-hPR2RjEYeTxgBstUDmaYF3dz5I&_nc_ohc=ETdwbSQfZ-IQ7kNvwHI4b3b&_nc_gid=akr6MNhpDDTqxQdJVQ9Dpg&edm=ACWDqb8BAAAA&ccb=7-5&oh=00_AQDmgskYUy3Qj-VVtwKrDQiFzCYY4MVODi725oPcpWvncw&oe=6A6C901F&_nc_sid=ee9879"}, "audio_filter_infos": [], "audio_parts": [], "audio_parts_by_filter": [], "consumption_info": {"display_media_id": null, "is_bookmarked": false, "is_trending_in_clips": false, "should_mute_audio_reason": "", "should_mute_audio_reason_type": null, "inline_audio_label": null, "display_labels": null, "display_labels_with_translations": null, "user_notes": null}, "xpost_fb_creator_info": null, "fb_downstream_use_xpost_metadata": {"downstream_use_xpost_deny_reason": "NONE"}}, "originality_info": null, "reels_on_the_rise_info": null, "reusable_text_attribute_string": null, "reusable_text_info": null, "shopping_info": null, "show_achievements": false, "may_have_template_info": null, "viewer_interaction_settings": null, "template_info": null}, "like_count": 7498, "has_liked": false, "hidden_likes_string_variant": -1, "caption": {"strong_id__": "18203355583330237", "bit_flags": 0, "created_at": 1785099607, "created_at_utc": 1785099607, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "18203355583330237", "share_enabled": false, "content_type": "comment", "media_id": "3950024532022829988", "status": "Active", "type": 1, "user_id": "1527886079", "text": "Wakil Presiden Gibran Rakabuming Raka kembali menegaskan pentingnya percepatan pengesahan RUU Perampasan Aset. Melalui unggahan ulang video di akun Instagram pribadinya, Gibran menilai koruptor harus dimiskinkan agar pemberantasan korupsi di Indonesia bisa berjalan lebih efektif.\n\nMenurut Gibran, data menunjukkan potensi kerugian negara akibat korupsi mencapai ratusan triliun rupiah. Namun, aset yang berhasil dikembalikan ke kas negara masih sangat kecil. Ia menyebut lebih dari 90 persen aset hasil korupsi belum berhasil dipulihkan, sementara modus kejahatan kini juga semakin terorganisir dan memanfaatkan teknologi.\n\nGibran menjelaskan RUU Perampasan Aset akan memberi kewenangan kepada negara untuk merampas aset yang terbukti berasal dari tindak pidana, seperti korupsi, narkotika, judi online, hingga perdagangan orang. Regulasi ini juga dinilai penting untuk memulihkan kerugian negara, termasuk dalam kasus ketika pelaku meninggal dunia atau melarikan diri ke luar negeri.\n\nBaca berita menarik lainnya hanya di detik.com! \n\nCreator: Putri\n\n#detikcom #gibranrakabumingraka #wapresgibran #RUUPerampasanAset", "user": {"strong_id__": "1527886079", "pk": "1527886079", "pk_id": "1527886079", "id": "1527886079", "is_unpublished": false, "fbid_v2": "17841400422393873", "username": "detikcom", "full_name": "detikcom", "is_private": false, "is_verified": true, "profile_pic_id": "3787832768936919438_1527886079", "profile_pic_url": "https://instagram.fccp2-1.fna.fbcdn.net/v/t51.82787-19/590420429_18550963456014080_6118536616993181808_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby4xMDgwLmMyIn0&_nc_ht=instagram.fccp2-1.fna.fbcdn.net&_nc_cat=1&_nc_oc=Q6cZ2gF3Md_jmxtlQkxXzXItrb4abOop4bd0bSj8wSu3-hPR2RjEYeTxgBstUDmaYF3dz5I&_nc_ohc=ETdwbSQfZ-IQ7kNvwHI4b3b&_nc_gid=akr6MNhpDDTqxQdJVQ9Dpg&edm=ACWDqb8BAAAA&ccb=7-5&oh=00_AQDmgskYUy3Qj-VVtwKrDQiFzCYY4MVODi725oPcpWvncw&oe=6A6C901F&_nc_sid=ee9879"}, "is_covered": false, "private_reply_status": 0, "text_translation": "Vice President Gibran Rakabuming Raka reaffirmed the importance of accelerated ratification of the Asset Confiscation Bill. Through a repost of a video on his personal Instagram account, Gibran assessed that corrupters should be impoverished so that the eradication of corruption in Indonesia can run more effectively.\n\nAccording to Gibran, the data shows the potential loss of the country due to corruption reaches hundreds of trillions of rupees. However, the assets that have been successfully returned to the state treasury are still very small. He mentioned more than 90 percent of corrupt assets have not been successfully recovered, while the crime mode is now also becoming more organized and utilizing technology.\n\nGibran explains the Asset Forfeiture Bill would give states authority to seize assets proven to stem from crimes, such as corruption, narcotics, online gambling, to human trafficking. This regulation is also considered important in recovering state losses, including in cases when perpetrators die or flee abroad.\n\n Baca berita menarik lainnya hanya di detik.com! \n\n Creator: Putri \n\n #detikcom #gibranrakabumingraka #wapresgibran #RUUPerampasanAset"}, "comment_count": 2109, "comment_likes_enabled": true, "play_count": 325469, "ig_play_count": 325469, "shop_routing_user_id": null, "featured_products": [], "video_duration": 105.56600189208984, "is_dash_eligible": 1, "video_dash_manifest": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<MPD xmlns=\"urn:mpeg:dash:schema:mpd:2011\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xsi:schemaLocation=\"urn:mpeg:dash:schema:mpd:2011 DASH-MPD.xsd\" profiles=\"urn:mpeg:dash:profile:isoff-on-demand:2011\" minBufferTime=\"PT2S\" type=\"static\" mediaPresentationDuration=\"PT105.566666S\" FBManifestTimestamp=\"1785118060\" FBManifestIdentifier=\"Ftj1taYNGBJyMmV2ZXZwOS1yMWdlbjJ2cDkZVvj3r9DfluME/Jmv2uWp4wSmjcbd5anjBNCA3eDlqeME+vPz4+Wp4wQiGBhkYXNoX2xuX2hlYWFjX3ZicjNfYXVkaW8iNgAUABIUAgA=\"><Period id=\"0\" duration=\"PT105.566666S\"><AdaptationSet id=\"0\" contentType=\"video\" subsegmentAlignment=\"true\" par=\"9:16\" FBUnifiedUploadResolutionMos=\"360:68.5\"><Representation id=\"1344321244527869v\" bandwidth=\"126013\" codecs=\"vp09.00.31.08.00.01.01.01.00\" mimeType=\"video/mp4\" sar=\"1:1\" FBEncodingTag=\"dash_r2evevp9-r1gen2vp9_q60\" FBContentLength=\"1662859\" FBPlaybackResolutionMos=\"0:100,360:85.9,480:83.8,720:81.7\" FBPlaybackResolutionMosConfidenceLevel=\"high\" FBPlaybackResolutionCsvqm=\"0:100,360:92.3,480:90.4,720:88\" FBAbrPolicyTags=\"\" 