l, "display_labels": null, "display_labels_with_translations": null, "user_notes": null}, "xpost_fb_creator_info": null, "fb_downstream_use_xpost_metadata": {"downstream_use_xpost_deny_reason": "NONE"}}, "originality_info": null, "reels_on_the_rise_info": null, "reusable_text_attribute_string": null, "reusable_text_info": null, "shopping_info": null, "show_achievements": false, "may_have_template_info": null, "viewer_interaction_settings": null, "template_info": null}, "like_count": 4139, "has_liked": false, "hidden_likes_string_variant": -1, "caption": {"strong_id__": "18010624502931785", "bit_flags": 0, "created_at": 1784874608, "created_at_utc": 1784874608, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "18010624502931785", "share_enabled": false, "content_type": "comment", "media_id": "3948136618242795752", "status": "Active", "type": 1, "user_id": "264699925", "text": "Gubernur DKI Jakarta Pramono Anung menyebut mobil Alphard yang diduga menerobos lampu merah di Bundaran Hotel Indonesia (HI) menggunakan pelat nomor palsu. Adapun insiden pengendara mobil Alphard melanggar lalu lintas viral di media sosial karena berujung cekcok usai ditegur oleh satpam.\n\nDalam kesempatan itu, Pramono mengungkap bahwa Pemprov DKI Jakarta memiliki rekaman CCTV yang lebih lengkap mengenai kejadian sebenarnya ketimbang video yang beredar di media sosial. \n\n#Okezone #Pramono #MobilAlphard #BundaranHI", "user": {"strong_id__": "264699925", "pk": "264699925", "pk_id": "264699925", "id": "264699925", "is_unpublished": false, "fbid_v2": "17841401797754135", "username": "okezonecom", "full_name": "Okezone.com", "is_private": false, "is_verified": true, "profile_pic_id": "3632812048997948137_264699925", "profile_pic_url": "https://scontent-den2-1.cdninstagram.com/v/t51.2885-19/498338670_18510436864059926_2821113304130037226_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby41MDAuYzIifQ&_nc_ht=scontent-den2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gGWipSkd5DSJWyd4zvSKdAka98JqTRnWBcjtXnvzwYeL1B2-jkWqvnmfmafnEUqtYk&_nc_ohc=W9o7Z9MhV8MQ7kNvwEJRLvH&_nc_gid=0msIt2yWsMwmq2mYEVDxGg&edm=ACWDqb8BAAAA&ccb=7-5&oh=00_AQCGREyr0vBZOeQv_8yw2oPLMDpvXEUBa0GDzdlbHZWhpA&oe=6A68EDBF&_nc_sid=ee9879"}, "is_covered": false, "private_reply_status": 0, "text_translation": "DKI Jakarta Governor Pramono Anung called Alphard's car suspected of breaking the red light at Roundabout Hotel Indonesia (HI) using fake license plate. As the incident of Alphard's car driver violated viral traffic on social media because the end of the hiccups was reprimanded by the security guard.\n\nOn that occasion, Pramono revealed that the Provincial Governor of DKI Jakarta had a more comprehensive CCTV footage of the actual incident than the video circulating on social media.\n\n #Okezone #Pramono #MobilAlphard #BundaranHI"}, "comment_count": 549, "comment_likes_enabled": true, "play_count": 107592, "ig_play_count": 107592, "shop_routing_user_id": null, "featured_products": [], "video_duration": 92.11299896240234, "is_dash_eligible": 1, "video_dash_manifest": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<MPD xmlns=\"urn:mpeg:dash:schema:mpd:2011\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xsi:schemaLocation=\"urn:mpeg:dash:schema:mpd:2011 DASH-MPD.xsd\" profiles=\"urn:mpeg:dash:profile:isoff-on-demand:2011\" minBufferTime=\"PT2S\" type=\"static\" mediaPresentationDuration=\"PT92.113564S\" FBManifestTimestamp=\"1784884798\" FBManifestIdentifier=\"Fvy4maYNGBFpZ19kYXNoX2Jhc2ljX3ZwORk2rKzHv6qokkKs/ZHIqqiSQqyYgMuqqJJCIhgYZGFzaF9sbl9oZWFhY192YnIzX2F1ZGlvIiwZGAVsaWdodAAWABQAEhQCAA==\"><Period id=\"0\" duration=\"PT92.113564S\"><AdaptationSet id=\"0\" contentType=\"video\" subsegmentAlignment=\"true\" par=\"9:16\" FBUnifiedUploadResolutionMos=\"360:65.3\"><Representation id=\"18617623792059926v\" bandwidth=\"149812\" codecs=\"vp09.00.21.08.00.01.01.01.00\" mimeType=\"video/mp4\" sar=\"1280:1281\" FBEncodingTag=\"dash_vp9-basic-gen2_360p\" FBCo