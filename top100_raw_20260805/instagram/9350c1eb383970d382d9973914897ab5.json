ull, "reusable_text_attribute_string": null, "reusable_text_info": null, "shopping_info": null, "show_achievements": false, "template_info": null, "may_have_template_info": null, "viewer_interaction_settings": null}, "like_count": 3129, "has_liked": false, "hidden_likes_string_variant": -1, "can_viewer_save": true, "caption": {"bit_flags": 0, "created_at": 1784611798, "created_at_utc": 1784611798, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "17890815651396495", "share_enabled": false, "content_type": "comment", "media_id": "3945932158962335913", "status": "Active", "type": 1, "user_id": "297782118", "strong_id__": "17890815651396495", "text": "Keberadaan atlet golf Jesslyn Wijaya hingga kini masih menjadi misteri setelah dilaporkan diduga diculik saat menghadiri pesta ulang tahun neneknya di sebuah restoran pada Senin (13/7/2026).\n\nKasat Reskrim Polres Metro Jakarta Pusat AKBP Roby Heri Saputra mengatakan, polisi menerima laporan dugaan penculikan dari teman korban. Berdasarkan laporan tersebut, korban diduga didatangi lima pria yang kemudian membawanya secara paksa dari lokasi.\n\nSejauh ini polisi masih mengumpulkan petunjuk, termasuk menelusuri informasi bahwa korban diduga berada di Malaysia, sementara ponselnya terakhir terdeteksi di Jakarta Utara.\n\nPenulis: Ridho Danu Prasetyo, Faieq Hidayat\nKreatif: Muchammad Chadziq Hanggeni Utomo\nProduser: Elizabeth Ayudya\n\n_ #JesslynWijaya #Penculikan #Read", "user": {"pk": "297782118", "pk_id": "297782118", "id": "297782118", "is_unpublished": false, "fbid_v2": "17841401623544652", "strong_id__": "297782118", "username": "kompascom", "full_name": "Kompas.com", "is_private": false, "is_verified": true, "profile_pic_id": "2943473406557247428_297782118", "profile_pic_url": "https://scontent-phx1-1.cdninstagram.com/v/t51.2885-19/311023253_1092650684949377_5722721028494463009_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby4zNzQuYzIifQ&_nc_ht=scontent-phx1-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gER7nl00z1z2tbmNQm_i1Q9UgcEzpskaVfYsVm0mQSuHQG8Xwl6Y5RYY0HaOUZZjU0dfSef-CkZJHbvpHTMRCuA&_nc_ohc=45pgHeYmIMsQ7kNvwFgVDPm&_nc_gid=wWSXsMtu7C4NQnWAgN26dg&edm=ACWDqb8BAAAA&ccb=7-5&oh=00_AQAlx_waEZRmBJE4ro6y8JogDbLwN-yDYla7fU0rhSSBGQ&oe=6A650253&_nc_sid=ee9879"}, "is_covered": false, "private_reply_status": 0, "text_translation": "The existence of golfer Jesslyn Wijaya is still a mystery after she was allegedly kidnapped while attending her grandmother's birthday party at a restaurant on Monday (13/7/2026).\n\nKasat Reskrim Police Metro Jakarta Pusat AKBP Roby Heri Saputra said, the police received a report of alleged kidnapping from the victim's friend. According to the report, the victim was allegedly approached by five men who then forcefully removed him from the location.\n\nSo far, police are still collecting clues, including tracing information that the victim is suspected to be in Malaysia, while his phone was last detected in North Jakarta.\n\nWriter: Ridho Danu Prasetyo, Faieq Hidayat\n Kreatif: Muchammad Chadziq Hanggeni Utomo \n Produser: Elizabeth Ayudya \n\n _ #JesslynWijaya #Penculikan #Read"}, "comment_count": 143, "comment_likes_enabled": true, "comment_inform_treatment": {"action_type": null, "should_have_inform_treatment": false, "text": "", "url": null}, "is_photo_comments_composer_enabled_for_author": false, "hide_view_all_comment_entrypoint": false, "is_comments_gif_composer_enabled": false, "locations": [], "play_count": 221948, "ig_play_count": 221948, "shop_routing_user_id": null, "featured_products": [], "are_remixes_crosspostable": true, "is_eligible_for_autodub": false, "is_eligible_for_autodub_upsell": false, "video_sticker_locales": [], "has_audio": true, "video_duration": 50.45500183105469, "is_dash_eligible": 1, "video_versions": [{"bandwidth": 815509, "height": 1280, "id": "1613097420820412v", "type": 101, "url": "https://scontent-phx1-1.cdninstagram.com/o1/v/t2/f2/m86/AQMYO_UmqS06DjOGWXTfaL4bhc2Df5S1JsohI6V0F