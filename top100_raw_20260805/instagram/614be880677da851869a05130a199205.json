_see_organic_insights": false, "invited_coauthor_producers": [], "product_suggestions": [], "igbio_product": null, "is_paid_partnership": false, "ig_media_sharing_disabled": false, "like_count": 10424, "has_liked": false, "hidden_likes_string_variant": -1, "caption": {"strong_id__": "18110658037993049", "bit_flags": 0, "created_at": 1785157323, "created_at_utc": 1785157323, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "18110658037993049", "share_enabled": false, "content_type": "comment", "media_id": "3950508359710993647", "status": "Active", "type": 1, "user_id": "297782118", "text": "(Berita selengkapnya cek IG Stories @kompascom)\n\nKuasa hukum eks Jaksa Agung Muda Tindak Pidana Khusus (Jampidsus) Febrie Adriansyah, Febri Diansyah mengatakan, kliennya tidak mendapatkan perlakuan khusus selama ditahan di Rumah Tahanan (Rutan) Komisi Pemberantasan Korupsi (KPK). \n\n“Saya sempat tanya juga tadi sarapan pagi itu bareng dengan para tahanan lain yang ya, tahanan lain kan ada sejumlah tahanan di KPK. Ada bihun, ada telur ceplok, bihun sama nasi putih sama teh,” kata Febri, usai mengunjungi kliennya di depan Rutan KPK, Jakarta, Senin (27/7/2026).\n\n“Dan itu perlakuannya sama dengan yang lain,” sambung dia.\n\nFebri juga memastikan, semua proses dan fasilitas yang diterima kliennya di Rutan KPK sama seperti tahanan lainnya.\n\nSebelumnya, Kejaksaan Agung menahan eks Jampidsus Febrie Adriansyah di Rutan KPK untuk 20 hari pertama penahanan.\n\nPenulis: Haryanti Puspa Sari\nEditor: Robertus Belarminus\n\n~J #KPK #FebrieAdriansyah #Kejagung", "is_covered": false, "private_reply_status": 0, "user": {"strong_id__": "297782118", "pk": "297782118", "pk_id": "297782118", "id": "297782118", "is_unpublished": false, "fbid_v2": "17841401623544652", "username": "kompascom", "full_name": "Kompas.com", "is_private": false, "is_verified": true, "profile_pic_id": "2943473406557247428_297782118", "profile_pic_url": "https://instagram.fbri2-1.fna.fbcdn.net/v/t51.2885-19/