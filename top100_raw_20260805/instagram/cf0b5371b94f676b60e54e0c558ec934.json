downstream_use_xpost_metadata": {"downstream_use_xpost_deny_reason": "NONE"}}, "originality_info": null, "reels_on_the_rise_info": null, "reusable_text_attribute_string": null, "reusable_text_info": null, "shopping_info": null, "show_achievements": false, "template_info": null, "may_have_template_info": null, "viewer_interaction_settings": null}, "like_count": 3334, "has_liked": false, "hidden_likes_string_variant": -1, "can_viewer_save": true, "caption": {"bit_flags": 0, "created_at": 1784702674, "created_at_utc": 1784702674, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "18138426340500219", "share_enabled": false, "content_type": "comment", "media_id": "3946694229823948417", "status": "Active", "type": 1, "user_id": "297782118", "strong_id__": "18138426340500219", "text": "Seorang ibu bernama Karina Chandra masih harus menghadapi proses hukum setelah dilaporkan suaminya karena melahirkan tidak sesuai keinginan sang suami. \n\nLaporan dugaan penggelapan asal-usul anak itu tercatat pada 8 Juni 2026 dan kini masih dalam tahap penyidikan.\n\n\"Saya tidak salah, saya hanya melakukan peristiwa melahirkan,\" kata Karina.\n\nPolresta Denpasar telah memeriksa sekitar enam saksi serta akan meminta keterangan ahli pidana untuk mendalami dokumen pembuktian.\n\nKuasa hukumnya juga meminta polisi tetap netral dan siap membawa perkara ini ke Mabes Polri jika proses penanganannya dinilai tidak sesuai aturan.\n\n🎥: @kabarbalihits\n\nSumber: Tribun-Bali.com \n\nKreatif: Blanka Rahel Maretha Joanne\nProduser: Elizabeth Ayudya Ratna Rininta\n\n~R #Denpasar #Viral #Voice", "user": {"pk": "297782118", "pk_id": "297782118", "id": "297782118", "is_unpublished": false, "fbid_v2": "17841401623544652", "strong_id__": "297782118", "username": "kompascom", "full_name": "Kompas.com", "is_private": false, "is_verified": true, "profile_pic_id": "2943473406557247428_297782118", "profile_pic_url": "https://scontent-cdg4-3.cdninstagram.com/v/t51.2885-19/311023253_1092650684949377_5722721028494463009_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby4zNzQuYzIifQ&_nc_ht=scontent-cdg4-3.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gHLR5fWBUtDjfktzU04hwgLipbn4PSXstGHLTCYB9JIQVLydsMcsVJ-fCGkkg_7oXw&_nc_ohc=45pgHeYmIMsQ7kNvwEUlweJ&_nc_gid=t9RSYDxGbi5fGROez_uJ4w&edm=ACWDqb8BAAAA&ccb=7-5&oh=00_AQAFroKWHDktaI9yHW_wfPSr5IEX8kwwuPILgm1fPP2MwA&oe=6A6653D3&_nc_sid=ee9879"}, "is_covered": false, "private_reply_status": 0, "text_translation": "A mother named Karina Chandra is still facing legal proceedings after being reported by her husband of giving birth against her husband's wishes.\n\nThe report of alleged blackout of the child's origin was recorded on June 8, 2026 and is now still in the educational stage.\n\n\"I'm not wrong, I'm just doing birth,\" says Karina.\n\nThe Denpasar police station has examined about six witnesses and will ask for the explanation of the criminal to deepen the evidence documents.\n\nThe power of law also requested the police to remain neutral and ready to bring this matter to Mabes Polri if its handling process is judged in accordance with the rules.\n\n 🎥: @kabarbalihits \n\n Sumber: Tribun-Bali.com \n\n Kreatif: Blanka Rahel Maretha Joanne \n Produser: Elizabeth Ayudya Ratna Rininta \n\n ~R #Denpasar #Viral #Voice"}, "comment_count": 774, "comment_likes_enabled": true, "comment_inform_treatment": {"action_type": null, "should_have_inform_treatment": false, "text": "", "url": null}, "is_photo_comments_composer_enabled_for_author": false, "hide_view_all_comment_entrypoint": false, "is_comments_gif_composer_enabled": false, "locations": [], "play_count": 192635, "ig_play_count": 192635, "shop_routing_user_id": null, "featured_products": [], "are_remixes_crosspostable": true, "is_eligible_for_autodub": false, "is_eligible_for_autodub_upsell": false, "video_sticker_locales": [], "has_audio": true, "video_duration": 78.04199981689453, "is_dash_eligible": 1, "video_versions": [{"bandwidth": 825496, "heigh