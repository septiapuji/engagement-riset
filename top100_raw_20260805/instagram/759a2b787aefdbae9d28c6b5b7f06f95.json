 [], "audio_parts_by_filter": [], "consumption_info": {"display_media_id": null, "is_bookmarked": false, "is_trending_in_clips": false, "should_mute_audio_reason": "", "should_mute_audio_reason_type": null, "inline_audio_label": null, "display_labels": null, "display_labels_with_translations": null, "user_notes": null}, "xpost_fb_creator_info": null, "fb_downstream_use_xpost_metadata": {"downstream_use_xpost_deny_reason": "NONE"}}, "originality_info": null, "reels_on_the_rise_info": null, "reusable_text_attribute_string": null, "reusable_text_info": null, "shopping_info": null, "show_achievements": false, "may_have_template_info": null, "viewer_interaction_settings": null, "template_info": null}, "like_count": 5476, "has_liked": false, "hidden_likes_string_variant": -1, "caption": {"strong_id__": "17966370345129317", "bit_flags": 0, "created_at": 1784784650, "created_at_utc": 1784784650, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "17966370345129317", "share_enabled": false, "content_type": "comment", "media_id": "3947381927123760602", "status": "Active", "type": 1, "user_id": "264699925", "text": "Pengacara kondang Hotman Paris Hutapea mengundurkan diri sebagai pengacara Eks Jampidsus Kejagung, Febrie Adriansyah yang terjerat kasus dugaan korupsi dan TPPU. Mundurnya Hotman Paris sebagai pengacara Febrie karena masalah kesehatannya.\n\nHotman Paris tampak mengenakan kursi roda saat memberikan keterangan pers pada awak media di RS Medistra, Setiabudi, Jakarta Selatan. \n\nDia juga sempat menunjukan bagian pinggangnya yang dibalut kain hitam untuk meredakan nyeri pinggangnya yang mengalami saraf kejepit.\n\n#Okezone #HotmanParis #Pengacara #FebrieAdriansyah", "user": {"strong_id__": "264699925", "pk": "264699925", "pk_id": "264699925", "id": "264699925", "is_unpublished": false, "fbid_v2": "17841401797754135", "username": "okezonecom", "full_name": "Okezone.com", "is_private": false, "is_verified": true, "profile_pic_id": "3632812048997948137_264699925", "profile_pic_url": "https://instagram.fsjp5-1.fna.fbcdn.net/v/t51.2885-19/498338670_18510436864059926_2821113304130037226_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby41MDAuYzIifQ&_nc_ht=instagram.fsjp5-1.fna.fbcdn.net&_nc_cat=1&_nc_oc=Q6cZ2gFHFBcTLsZR7dMPcpDmCUwjBmjfrw5l07Dw9FGOM1eUKBE3s9mG94vPkWDtdbAsCOc&_nc_ohc=W9o7Z9MhV8MQ7kNvwHo5XJt&_nc_gid=QiYSpXV8VKtKi10ejywIlg&edm=ACWDqb8BAAAA&ccb=7-5&oh=00_AQAT6BI_zANYDH_erokGYwY83jL1R3wP-neNFOP13fUKdg&oe=6A679C3F&_nc_sid=ee9879"}, "is_covered": false, "private_reply_status": 0, "text_translation": "Famous lawyer Hotman Paris Hutapea resigns as lawyer of Ex Jampidsus Kejagung, Febrie Adriansyah who was caught in alleged corruption case and TPPU. Hotman Paris resigns as Febrie's lawyer due to health issues.\n\nHotman Paris was seen in a wheelchair while giving a press briefing to the media crew at Medistra Hospital, Setiabudi, South Jakarta.\n\nShe also had time to show off her waist, wrapped in black cloth, to ease her lower back pain, which she suffered from pinched nerve.\n\n #Okezone #HotmanParis #Pengacara #FebrieAdriansyah"}, "comment_count": 3033, "comment_likes_enabled": true, "play_count": 360163, "ig_play_count": 360163, "shop_routing_user_id": null, "featured_products": [], "video_duration": 102.93399810791016, "is_dash_eligible": 1, "video_dash_manifest": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<MPD xmlns=\"urn:mpeg:dash:schema:mpd:2011\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xsi:schemaLocation=\"urn:mpeg:dash:schema:mpd:2011 DASH-MPD.xsd\" profiles=\"urn:mpeg:dash:profile:isoff-on-demand:2011\" minBufferTime=\"PT2S\" type=\"static\" mediaPresentationDuration=\"PT102.934059S\" FBManifestTimestamp=\"1784800224\" FBManifestIdentifier=\"FsCPj6YNGBFpZ19kYXNoX2Jhc2ljX3ZwORk2rOrg6MeVkkKsu6vxx5WSQqzWmfTHlZJCIhgYZGFzaF9sbl9oZWFhY192YnIzX2F1ZGlvIiwZGA5sYXRhbV9tb2RlcmF0ZQAWABQAEhQCAA==\"><Period id=\"0\" duration=\"PT102.934059S\"><AdaptationSet id=\"0\" cont