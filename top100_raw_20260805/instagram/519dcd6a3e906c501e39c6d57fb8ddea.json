ONE"}}, "originality_info": null, "reels_on_the_rise_info": null, "reusable_text_attribute_string": null, "reusable_text_info": null, "shopping_info": null, "show_achievements": false, "template_info": null, "may_have_template_info": null, "viewer_interaction_settings": null}, "like_count": 9299, "has_liked": false, "hidden_likes_string_variant": -1, "can_viewer_save": true, "caption": {"bit_flags": 0, "created_at": 1784027703, "created_at_utc": 1784027703, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "17976522519114238", "share_enabled": false, "content_type": "comment", "media_id": "3941017553958893197", "status": "Active", "type": 1, "user_id": "310386046", "strong_id__": "17976522519114238", "text": "Sekretaris Kabinet Teddy Indra Wijaya memberikan pembekalan selama tiga jam untuk para taruna Akademi Militer di Magelang, Jawa Tengah. Teddy hadir di Akmil pada 13 Juli 2026.\n\nDalam kesempatan tersebut, Teddy hadir bersama delapan pembicara lainnya yang turut berbagi pengalaman dan wawasan kepada para taruna. Mereka berbicara soal pengembangan kapasitas diri, menjaga disiplin, dan mempersiapkan diri menghadapi tantangan di masa depan kepada para taruna.\n\nBaca selengkapnya di tempo.co dan link in bio.\n\n#tempodotco #TUpdate #TeddyIndraWijaya", "user": {"pk": "310386046", "pk_id": "310386046", "id": "310386046", "is_unpublished": false, "fbid_v2": "17841401501384849", "strong_id__": "310386046", "username": "tempodotco", "full_name": "tempo.co by Tempo Media Group", "is_private": false, "is_verified": true, "profile_pic_id": "3724210851730622579_310386046", "profile_pic_url": "https://instagram.fhan2-5.fna.fbcdn.net/v/t51.82787-19/550411618_18530886049050047_529007314515339118_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby4xMDAyLmMyIn0&_nc_ht=instagram.fhan2-5.fna.fbcdn.net&_nc_cat=1&_nc_oc=Q6cZ2gFHH-E9JBfvFwSHqUP75_3IgBq3vZri3e72sNi9PFsLqg2nkOyYExkTU4y9CZRbj2c&_nc_ohc=jo6rB_LkMr8Q7kNvwGrpP4e&_nc_gid=78_Y7FZhKla54VChGtgVWw&edm=ACWDqb8BAAAA&ccb=7-5&oh=00_AQB5brS79LlL1l5-UPtxhdagn6WOk7I0OGdGFXX99bY3MQ&oe=6A5CACBF&_nc_sid=ee9879"}, "is_covered": false, "private_reply_status": 0, "text_translation": "Cabinet Secretary Teddy Indra Wijaya gave three hours of supplies to the military academy cadres in Magelang, Central Java. Teddy arrives in Akmil on July 13, 2026.\n\nOn the occasion, Teddy was present along with eight other speakers who shared their experiences and insights with the farmers. They talk about developing self-capacity, maintaining discipline, and preparing for future challenges to the Taruna.\n\nRead more at tempo.co and link in bio.\n\n #tempodotco #TUpdate #TeddyIndraWijaya"}, "comment_count": 1234, "comment_likes_enabled": true, "comment_inform_treatment": {"action_type": null, "should_have_inform_treatment": false, "text": "", "url": null}, "is_photo_comments_composer_enabled_for_author": false, "hide_view_all_comment_entrypoint": false, "is_comments_gif_composer_enabled": false, "locations": [], "play_count": 566407, "ig_play_count": 566407, "shop_routing_user_id": null, "featured_products": [], "are_remixes_crosspostable": true, "is_eligible_for_autodub": false, "is_eligible_for_autodub_upsell": false, "video_sticker_locales": [], "has_audio": true, "video_duration": 16.281999588012695, "is_dash_eligible": 1, "video_versions": [{"bandwidth": 614141, "height": 1280, "id": "1024663226991210v", "type": 101, "url": "https://instagram.fhan2-5.fna.fbcdn.net/o1/v/t2/f2/m86/AQNhE7B8zYurWHLlmMUeInW78NHwdILdIH1hx3qfsEwx2AA9qhr77uPAquzhEQ8WE_6o7WCjeWq90s9B2sms3T9qu5mc6cloc7X9M7A.mp4?_nc_cat=102&_nc_oc=AdqyBHxmFv1B48YPhN2r8u_mn1f5LESGUDuboYPXWdRlAOdIr8Rf8fEXa9fypmtBB1E&_nc_sid=5e9851&_nc_ht=instagram.fhan2-5.fna.fbcdn.net&_nc_ohc=HyWpLGkcPqUQ7kNvwGI8Qu7&efg=eyJ2ZW5jb2RlX3RhZyI6Inhwdl9wcm9ncmVzc2l2ZS5JTlNUQUdSQU0uQ0xJUFMuQzMuNzIwLmRhc2hfYmFzZWxpbmVfMV92MSIsInhwdl9hc3NldF9pZCI6MTAyNDY2MjgwMzY1NzkxOSwiYXNzZXRfYWdlX2RheXMiOjAsInZpX3VzZWNhc2VfaWQiOjEwMDk5LCJkdXJhdGlvbl9zIjo