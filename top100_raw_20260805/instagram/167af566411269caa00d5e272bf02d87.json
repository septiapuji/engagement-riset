st_fb_creator_info": null, "fb_downstream_use_xpost_metadata": {"downstream_use_xpost_deny_reason": "NONE"}}, "originality_info": null, "reels_on_the_rise_info": null, "reusable_text_attribute_string": null, "reusable_text_info": null, "shopping_info": null, "show_achievements": false, "template_info": null, "may_have_template_info": null, "viewer_interaction_settings": null}, "like_count": 11907, "has_liked": false, "hidden_likes_string_variant": -1, "can_viewer_save": true, "caption": {"bit_flags": 0, "created_at": 1783850829, "created_at_utc": 1783850829, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "18157406737474484", "share_enabled": false, "content_type": "comment", "media_id": "3939547679738075571", "status": "Active", "type": 1, "user_id": "3286401357", "strong_id__": "18157406737474484", "text": "Presiden Prabowo mengecam para pihak yang masih berupaya mencuri uang negara. Ia meminta para oknum pejabat menghentikan praktik rasuah.  Hal itu disampaikan Prabowo dalam acara Puncak Peringatan Hari Koperasi ke-79 di Indonesia Arena, Gelora Bung Karno (GBK), Jakarta, Minggu (12/7).⁠\n⁠\n\"Untuk sekian kali lagi saya bicara dari dulu: Hei para koruptor sadar diri! Hentikan praktik-praktik kau, hentikan! Rakyat tidak bodoh! Hentikan! Kembalikan kekayaan rakyat, kembalikan dengan baik,\" tegasnya. Prabowo bilang, masyarakat Indonesia memang dikenal memiliki sifat pemaaf. Namun, praktik korupsi tetap perlu dihilangkan demi kesejahteraan masyarakat.⁠\n⁠\n\"Kita bangsa pemaaf, tapi rakyat butuh keadilan, rakyat butuh kesejahteraan. Rakyat butuh sekolah yang baik. Guru-guru butuh gaji yang baik,\" ujar Prabowo.⁠\n⁠\n\"Dokter-dokter, perawat-perawat butuh gaji yang baik. Tentara dan polisi butuh gaji yang baik supaya mereka tidak meres dari rakyat. Pegawai negeri butuh gaji yang baik supaya mereka enggak korupsi,\" lanjutnya.⁠\n⁠\n📸: Dok. YouTube Sekretariat Presiden.⁠\n⁠\nBaca selengkapnya dengan klik link di bio. Cari tahu berita update lainnya dengan download aplikasi kumparan di App Store atau Google Play.⁠\n⁠\n📝: newsupdate | update | news | svt | R120 | E025⁠\n⁠\n#bicarafaktalewatberita #kumparan", "user": {"pk": "3286401357", "pk_id": "3286401357", "id": "3286401357", "is_unpublished": false, "fbid_v2": "17841403160730800", "strong_id__": "3286401357", "username": "kumparancom", "full_name": "kumparan", "is_private": false, "is_verified": true, "profile_pic_id": "3872841455644029494_3286401357", "profile_pic_url": "https://instagram.fmch2-1.fna.fbcdn.net/v/t51.82787-19/669761242_18459146461105358_5197641318677468020_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby4xMDgwLmMyIn0&_nc_ht=instagram.fmch2-1.fna.fbcdn.net&_nc_cat=1&_nc_oc=Q6cZ2gE2D-FsnzXN-_8S1ltewWqXFv1Rr-cxoCABmuHXOk1Ed_MTVyV-R87h_6qb99Nt6Mc&_nc_ohc=CRc1B13-NwEQ7kNvwFpKu5k&_nc_gid=cU04QrdDKBE-HUqARND5fQ&edm=ACWDqb8BAAAA&ccb=7-5&oh=00_AQBxxShvJVxeEXEqTHgOGGEZYOlwmvHL73HbqhA3O3InOg&oe=6A595EB5&_nc_sid=ee9879"}, "is_covered": false, "private_reply_status": 0, "text_translation": "President Prabowo condemns the parties who are still trying to steal state money. He asked the oknum officials to stop the practice of corruption. It was conveyed by Prabowo in the Summit event Commemorating the 79th Cooperation Day at Indonesia Arena, Gelora Bung Karno (GBK), Jakarta, Sunday (12/7).\n\n\"For once again I speak from the past: Hey corrupt people wake up! Stop your practices, just stop it! The people are not stupid! Stop it! Return the wealth of the people, return it well,\" he insisted. Prabowo said, Indonesian people are known to have a forgiving nature. However, corruption practices still need to be eliminated for the welfare of the society.\n\n\"We are a forgiving nation, but the people need justice, the people need welfare.\" People need good schools. Teachers need a good salary,\" Prabowo said.\n\n\"Doctors, nurses need a good salary. Army and police need good pay so they don't take away from the people. Civil servants need a good salary so that they are not corrupt,\" he continued.\n\n📸: Doc. Presidential Secretariat YouTube.\n\nRead more by clicking on the link in the bio. Find out more update news by downloading the Coil app on the App Store or Google Play.\n\n 📝: newsupdate | update | news | svt | R120 | E025  \n\n #bicarafaktalewatberita #kumparan"}, "comment_count": 4016, "comment_likes_enabled": true, "comment_inform_treatment": {"action_type": null, "should_have_inform_treatment": false, "text": "", "url": null}, "is_photo_comments_composer_enabled_for_author": false, "hide_view_all_comment_entrypoint": false, "is_comments_gif_composer_enabled": false, "locations": [], "play_count": 420651, "ig_play_count": 420651, "shop_routing_user_id": null, "featured_products": [], "are_remixes_crosspostable": true, "is_eligible_for_autodub": false, "is_eligible_for_autodub_upsell": false, "video_sticker_locales": [], "has_audio": true, "video_duration": 80.27100372314453, "is_dash_eligible": 1, "video_versions": [{"bandwidth": 772113, "height": 1280, "id": "18476554525105358v", "type": 101, "url": "https://instagram.fmch2-1.fna.fbcdn.net/o1/v/t2/f2/m86/AQMvxy0POf5aNKGh_VZ30fqkc2W-H44JQ2Sf6irzkevgWz_X6M8Wrm_Di_70ZuFHYHAPKjsK3uw6BbRA1O9cuD2opVrDy6ac1_13m_s.mp4?_nc_cat=109&_nc_oc=Ado1dIWCPRQh0zym-90nZk210DU0wENVmZkNUllUFXyaPCKdEvOyVIDEqHydOCceIJA&_nc_sid=5e9851&_nc_ht=instagram.fmch2-1.fna.fbcdn.net&_nc_ohc=SPVDFOqSz_EQ7kNvwHycI_T&efg=eyJ2ZW5jb2RlX3RhZyI6Inhwdl9wcm9ncmVzc2l2ZS5JTlNUQUdSQU0uQ0xJUFMuQzMuNzIwLmRhc2hfYmFzZWxpbmVfMV92MSIsInhwdl9hc3NldF9pZCI6MTg0NzY1NTQ0MzUxMDUzNTgsImFzc2V0X2FnZV9kYXlzIjowLCJ2aV91c2VjYXNlX2lkIjoxMDA5OSwiZHVyYXRpb25fcyI6ODAsInVybGdlbl9zb3VyY2UiOiJ3d3cifQ%3D%3D&ccb=17-1&vs=7e2c83b6366fc925&_nc_&_nc_gid=cU04QrdDKBE-HUqARND5fQ&_nc_ss=7a22e&_nc_zt=28&oh=00_AQCoNRTeTWcE8UjiwYTwaw0ZEuJtlGozDfdYJueDmIPPVQ&oe=6A557A9E", "url_expiration_timestamp_us": null, "width": 720, "fallback": null}, {"bandwidth": 772113, "height": 1280, "id": "18476554525105358v", "type": 102, "u