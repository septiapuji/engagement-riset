51.82787-19/590420429_18550963456014080_6118536616993181808_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby4xMDgwLmMyIn0&_nc_ht=instagram.fosm2-1.fna.fbcdn.net&_nc_cat=1&_nc_oc=Q6cZ2gGAP2tG-YYSsJeDx4RsvSPuOiD03uIVEqzNzZ7rYHQEqSbnzXgWy8AQcQUS6iYv8sQ&_nc_ohc=ACvEmBRqODIQ7kNvwE4erVE&_nc_gid=Lp6c70HorVM6vePy07leEA&edm=ACWDqb8BAAAA&ccb=7-5&oh=00_AQC5xIc5bdvY3dH9uEwQO_8xVAd4xmXoGbQ_qPJSup5Iug&oe=6A60EADF&_nc_sid=ee9879", "strong_id__": "1527886079"}, "audio_filter_infos": [], "audio_parts": [], "audio_parts_by_filter": [], "consumption_info": {"display_media_id": null, "is_bookmarked": false, "is_trending_in_clips": false, "should_mute_audio_reason": "", "should_mute_audio_reason_type": null, "inline_audio_label": null, "display_labels": null, "display_labels_with_translations": null, "user_notes": null}, "xpost_fb_creator_info": null, "fb_downstream_use_xpost_metadata": {"downstream_use_xpost_deny_reason": "NONE"}}, "originality_info": null, "reels_on_the_rise_info": null, "reusable_text_attribute_string": null, "reusable_text_info": null, "shopping_info": null, "show_achievements": false, "template_info": null, "may_have_template_info": null, "viewer_interaction_settings": null}, "like_count": 12290, "has_liked": false, "hidden_likes_string_variant": -1, "can_viewer_save": true, "caption": {"bit_flags": 0, "created_at": 1784337171, "created_at_utc": 1784337171, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "17924048994385385", "share_enabled": false, "content_type": "comment", "media_id": "3943628118384245797", "status": "Active", "type": 1, "user_id": "1527886079", "strong_id__": "17924048994385385", "text": "Seorang pilot di Inggris punya cara unik untuk mengusir rasa bosan saat menerbangkan pesawat. Di tengah penerbangan uji coba, ia membuat pola di langit hingga membentuk tulisan \"I'm bored\" atau \"Saya bosan\".⁣\n⁣\nDilansir dari CNN, aksi tersebut terekam oleh situs pelacak penerbangan Flightradar24. Pesan itu dibuat saat pesawat melakukan penerbangan uji coba selama sekitar dua jam pada Sabtu pagi waktu setempat.⁣\n⁣\nBerdasarkan data pelacakan, pesawat milik maskapai Ravenair itu berangkat dari Kota Liverpool, Inggris bagian barat laut. Pesawat kemudian terbang melintasi sejumlah wilayah di Wirral Peninsula dan Cheshire, sebelum menuju Wales bagian utara.⁣\n⁣\nSelama sekitar 20 menit, pilot membuat manuver berputar-putar di atas kawasan Dee Estuary hingga membentuk tulisan yang terlihat jelas dari jalur penerbangan.⁣\n⁣\nPesawat jenis Piper Tomahawk itu diketahui sedang menjalani penerbangan uji setelah salah satu komponennya diganti. Penerbangan tersebut dilakukan oleh seorang instruktur terbang berusia 20-an.⁣\n⁣\nManajer operasional Ravenair, Wayne Barrett, mengatakan aksi tersebut kemungkinan dilakukan karena pilot sedang menjalani penerbangan uji yang cukup membosankan.⁣\n⁣\n\"Saya pikir pilot memang sedikit bosan karena ini hanya penerbangan uji coba. Tapi, kemampuan menerbangkannya cukup luar biasa,\" ujar Barrett kepada BBC.⁣\n⁣\nMenurut Barrett, komponen silinder pada mesin pesawat sebelumnya diganti dan harus diuji untuk memastikan pesawat aman digunakan kembali.⁣\n⁣\nMeski mengaku bosan, Barrett menyebut sang pilot justru harus berkonsentrasi tinggi untuk membentuk tulisan tersebut di udara.⁣\n⁣\n\"Dia mungkin merasa bosan, tapi untuk mengeja kata-kata itu dia harus sangat fokus. Jadi sebenarnya dia jauh dari kata bosan,\" katanya.⁣\n⁣\nBaca berita menarik lainnya hanya di detik.com!⁣\n⁣\nVideo: Instagram/Flightradar24⁣\nCreator: Prastiwi⁣\n⁣\n#detikcom #flightradar24 #pilot #imbored", "user": {"pk": "1527886079", "pk_id": "1527886079", "id": "1527886079", "is_unpublished": false, "fbid_v2": "17841400422393873", "strong_id__": "1527886079", "username": "detikcom", "full_name": "detikcom", "is_private": false, "is_verified": true, "profile_pic_id": "3787832768936919438_1527886079", "profile_pic_url": "https://instagram.fosm2-1.fna.fbcdn.net/v/t51.82787-19/590420429_18550963456014080_6118536616993181808_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby4xMDgwLmMyIn0&_nc_ht=instagram.fosm2-1.fna.fbcdn.net&_nc_cat=1&_nc_oc=Q6cZ2gGAP2tG-YYSsJeDx4RsvSPuOiD03uIVEqzNzZ7rYHQEqSbnzXgWy8AQcQUS6iYv8sQ&_nc_ohc=ACvEmBRqODIQ7kNvwE4erVE&_nc_gid=Lp6c70HorVM6vePy07leEA&edm=ACWDqb8BAAAA&ccb=7-5&oh=00_AQC5xIc5bdvY3dH9uEwQO_8xVAd4xmXoGbQ_qPJSup5Iug&oe=6A60EADF&_nc_sid=ee9879"}, "is_covered": false, "private_reply_status": 0, "text_translation": "A pilot in the UK has a unique way of chasing away boredom while flying a plane. In the middle of a test flight, he made patterns in the sky to form the writings \"I'm bored\" or \"I'm boring\".\n\nLaunched from CNN, the action was recorded by Flightradar24 flight tracker site. The message was made while the aircraft went on a test flight for about two hours on Saturday morning local time.\n\nAccording to tracking data, the Ravenair aircraft departed from Liverpool in the northwest of England. The aircraft then flew over a number of areas on the Wirral Peninsula and Cheshire, before heading to north Wales.\n\nFor around 20 minutes, the pilots maneuvered in circles over the Dee Estuary to form writings clearly visible from the flightway.\n\nThe Piper Tomahawk aircraft is known to be undergoing a test flight after one of its components was replaced. The flight was performed by a flying instructor in his 20s.\n\nRavenair operations manager Wayne Barrett said the action was likely because the pilot was undergoing a rather boring test flight.\n\n“I think the pilot was a little bored because this was just a test flight. \"But, his flying ability is quite extraordinary,\" Barrett told the BBC.\n\nAccording to Barrett, the cylinder components on the previous aircraft engine were replaced and should be tested to ensure the aircraft is safe to use again.\n\nDespite admitting to boredom, Barrett says the pilot exactly had to concentrate in order to form the writing in the air.\n\n\"He may be bored, but to spell those words he must be very focused. \"So actually he is far from the word bored,\" he said.\n\nRead more exciting news only at detik.com !\n\nVideo: Instagram/Flightradar24\n Creator: Prastiwi  \n\n #detikcom #flightradar24 #pilot #imbored"}, "comment_count": 216, "comment_likes_enabled": true, "comment_inform_treatment": {"action_type": null, "should_have_inform_treatment": false, "text": "", "url": null}, "is_photo_comments_composer_enabled_for_author": false, "hide_view_all_comment_entrypoint": false, "is_comments_gif_composer_enabled": false, "locations": [], "play_count": 720162, "ig_play_count": 720162, "shop_routing_user_id": null, "featured_products": [], "are_remixes_crosspostable": true, "is_eligible_for_autodub": false, "is_eligible_for_autodub_upsell": false, "video_sticker_locales": [], "has_audio": true, "video_duration": 21.87299919128418, "is_dash_eligible": 1, "video_versions": [{"bandwidth": 250814, "height": 900, "id": "1378026351094320v", "type": 101, "url": "https://instagram.fosm2-2.fna.fbcdn.net/o1/v/t2/f2/m86/AQOk2o8RzfLR8eHZvPm-ceToxGyXVZeXFvbBGxo9_QQ9w-7W3ZgCdlmtsLynd3X6ZqXr86XpglySUwfg9cbFIxMrTe4S862-S3pG1ME.mp4?_nc_cat=111&_nc_oc=Adq7IP2XLjmPz8QbciKT2apkaEevRPYQckCVQq9vYThZlfVdyG-PSRdaXxxWWjUUouY&_nc_sid=5e9851&_nc_ht=instagram.fosm2-2.fna.fbcdn.net&_nc_ohc=U6q_-OPlcZ4Q7kNvwF3msNv&efg=eyJ2ZW5jb2RlX3RhZyI6Inhwdl9wcm9ncmVzc2l2ZS5JTlNUQUdSQU0uQ0xJUFMuQzMuNzIwLmRhc2hfYmFzZWxpbmVfMV92MSIsInhwdl9hc3NldF9pZCI6MTM3ODAyNjA2NDQyNzY4MiwiYXNzZXRfYWdlX2RheXMiOjAsInZpX3VzZWNhc2VfaWQiOjEwMDk5LCJkdXJhdGlvbl9zIjoyMSwidXJsZ2VuX3NvdXJjZSI6Ind3dyJ9&ccb=17-1&vs=c5a479d987652f2e&_nc_&_nc_gid=Lp6c70HorVM6vePy07leEA&_nc_ss=7a22e&_nc_map=urlgen_bucketless&_nc_zt=28&oh=00_AQAEUQFolz6ZD1C2SNP8AbVjiuVDsw0gUXkNmxD6QML7LA&oe=6A5CE30C", "url_expiration_timestamp_us": null, "width": 720, "fallback": null}, {"bandwidth": 250814, "height": 900, "id": "1378026351094320v", "type": 102, "url": "https://instagram.fosm2-2.fna.fbcdn.net/o1/v/t2/