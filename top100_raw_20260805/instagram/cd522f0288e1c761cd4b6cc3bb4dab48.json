ull, "fb_downstream_use_xpost_metadata": {"downstream_use_xpost_deny_reason": "NONE"}}, "originality_info": null, "reels_on_the_rise_info": null, "reusable_text_attribute_string": null, "reusable_text_info": null, "shopping_info": null, "show_achievements": false, "template_info": null, "may_have_template_info": null, "viewer_interaction_settings": null}, "like_count": 5552, "has_liked": false, "hidden_likes_string_variant": -1, "can_viewer_save": true, "caption": {"bit_flags": 0, "created_at": 1783658714, "created_at_utc": 1783658714, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "18151046197496185", "share_enabled": false, "content_type": "comment", "media_id": "3937936332366353452", "status": "Active", "type": 1, "user_id": "310386046", "strong_id__": "18151046197496185", "text": "Kejaksaan Agung meminta masyarakat tidak mengaitkan seseorang atau suatu institusi dengan dugaan tindak pidana korupsi hanya berdasarkan informasi yang beredar di media massa maupun media sosial.\n\nImbauan itu disampaikan Kepala Pusat Penerangan Hukum Kejagung, Anang Supriatna, di tengah sorotan terhadap penggeledahan yang dilakukan penyidik kepolisian di sejumlah lokasi, termasuk Cafe de’Clan Signature di Jakarta Selatan, yang diduga berkaitan dengan Jaksa Agung Muda Tindak Pidana Khusus (Jampidsus), Febrie Adriansyah.\n\nBaca selengkapnya di tempo.co dan link in bio.\n\n#TUpdate #tempodotco #kejagung #jampidsus", "user": {"pk": "310386046", "pk_id": "310386046", "id": "310386046", "is_unpublished": false, "fbid_v2": "17841401501384849", "strong_id__": "310386046", "username": "tempodotco", "full_name": "tempo.co by Tempo Media Group", "is_private": false, "is_verified": true, "profile_pic_id": "3724210851730622579_310386046", "profile_pic_url": "https://instagram.fmvd2-2.fna.fbcdn.net/v/t51.82787-19/550411618_18530886049050047_529007314515339118_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby4xMDAyLmMyIn0&_nc_ht=instagram.fmvd2-2.fna.fbcdn.net&_nc_cat=1&_nc_oc=Q6cZ2gFFtzozFJu6rM2-KpYp5ALfs4MgiP_T2OBLXn7QOavFdqoqlMkd1YeAayd6OGlPpTw&_nc_ohc=nagt0u9yQkgQ7kNvwFCDCCJ&_nc_gid=pqGAt7idBalbHHLHd3tmTA&edm=ACWDqb8BAAAA&ccb=7-5&oh=00_AQD4OCfAk-VGOGAftB_fos12ESMwIC3YQLV5wHFoUY7qqA&oe=6A564D7F&_nc_sid=ee9879"}, "is_covered": false, "private_reply_status": 0, "text_translation": "The General Prosecutor asks the public not to associate a person or an institution with alleged corruption offenses based on information circulating in mass media or social media.\n\nThe insight was delivered by the Head of Corn Law Information Center, Anang Supriatna, amid the highlights to searches conducted by police investigators in a number of locations, including Cafe de’Clan Signature in South Jakarta, which is suspected to be related to the Young Prosecutor General Special Crimes (Jampidsus), Febrie Adriansyah.\n\nRead more at tempo.co and link in bio.\n\n #TUpdate #tempodotco #kejagung #jampidsus"}, "comment_count": 1118, "comment_likes_enabled": true, "comment_inform_treatment": {"action_type": null, "should_have_inform_treatment": false, "text": "", "url": null}, "is_photo_comments_composer_enabled_for_author": false, "hide_view_all_comment_entrypoint": false, "is_comments_gif_composer_enabled": false, "locations": [], "play_count": 163414, "ig_play_count": 163414, "shop_routing_user_id": null, "featured_products": [], "are_remixes_crosspostable": true, "is_eligible_for_autodub": false, "is_eligible_for_autodub_upsell": false, "video_sticker_locales": [], "has_audio": true, "video_duration": 31.764999389648438, "is_dash_eligible": 1, "video_versions": [{"bandwidth": 357368, "height": 1280, "id": "851750174445244v", "type": 101, "url": "https://instagram.fmvd2-1.fna.fbcdn.net/o1/v/t2/f2/m86/AQOtegg3DwoYVwtnqA4n9BesaRMgAFS955lnqVSzf6u2Il8m330Pv5U2V44gaq-GDLCyGjOOnAt3mxSgmYCGd_RrJzh1Xqkmtt7obS8.mp4?_nc_cat=102&_nc_oc=AdoTfAYiQ5670wXubLl4wdNrm456AyC5ZM7BshXkQlslSjgQa4fDs6bPmCS1G0clF3U&_nc_sid=5e9851&_nc_ht=instagram.fmvd2-1.f