50963456014080_6118536616993181808_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby4xMDgwLmV4cGVyaW1lbnRhbCJ9&_nc_ht=scontent-mia5-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gGUTxd2U1y2NOj0rJ1jE0MXplOi-ZKGxXEC4uLC3iHRSDOIZhaKdcDpKzJzHaZ1Hgs&_nc_ohc=VJ_qPIifh0YQ7kNvwETMNuv&_nc_gid=eJhda8SyHI_jBRWI_7cIIQ&edm=ACWDqb8BAAAA&ccb=7-5&oh=00_AQCyKBU3ATcGrO9gfk9LBMdtIzZNcAHsL1W_uWQu97l8mQ&oe=6A565EDF&_nc_sid=ee9879", "strong_id__": "1527886079"}, "audio_filter_infos": [], "audio_parts": [], "audio_parts_by_filter": [], "consumption_info": {"display_media_id": null, "is_bookmarked": false, "is_trending_in_clips": false, "should_mute_audio_reason": "", "should_mute_audio_reason_type": null, "inline_audio_label": null, "display_labels": null, "display_labels_with_translations": null, "user_notes": null}, "xpost_fb_creator_info": null, "fb_downstream_use_xpost_metadata": {"downstream_use_xpost_deny_reason": "NONE"}}, "originality_info": null, "reels_on_the_rise_info": null, "reusable_text_attribute_string": null, "reusable_text_info": null, "shopping_info": null, "show_achievements": false, "template_info": null, "may_have_template_info": null, "viewer_interaction_settings": null}, "like_count": 12612, "has_liked": false, "hidden_likes_string_variant": -1, "can_viewer_save": true, "caption": {"bit_flags": 0, "created_at": 1783659017, "created_at_utc": 1783659017, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "18110473003761268", "share_enabled": false, "content_type": "comment", "media_id": "3937939524365389718", "status": "Active", "type": 1, "user_id": "1527886079", "strong_id__": "18110473003761268", "text": "Jampidsus Febrie Adriansyah mengakui rumah di kawasan Sentul, Bogor, Jawa Barat (Jabar), yang digeledah pihak kepolisian terkait tiga kasus korupsi merupakan rumah pribadinya. Di rumah tersebut ditemukan 74 kg emas dan uang ratusan miliar rupiah.\n\n“Yang kedua, tentang rumah Sentul, itu memang rumah pribadi Jampidsus yang sudah sejak lama. Itu bisa dilihat bagaimana kepemilikan sejak awal,” kata Febrie saat jumpa pers di gedung Bundar, Kejagung, Kebayoran Baru, Jakarta Selatan, Jumat (10/7/2026).\n\nFebrie mengatakan seluruh puluhan kg batang emas dan uang ratusan miliar rupiah tersebut ada pemiliknya. Namun, Febrie tidak secara gamblang bicara siapa pemilik batangan emas dan uang ratusan miliar rupiah tersebut.\n\nBaca berita selengkapnya hanya di detik.com! \n\nVideo: Yumna Khan \nCreator: Putri\n\n#detikcom #korupsi #jampidsus #febrieadriansyah", "user": {"pk": "1527886079", "pk_id": "1527886079", "id": "1527886079", "is_unpublished": false, "fbid_v2": "17841400422393873", "strong_id__": "1527886079", "username": "detikcom", "full_name": "detikcom", "is_private": false, "is_verified": true, "profile_pic_id": "3787832768936919438_1527886079", "profile_pic_url": "https://scontent-mia5-1.cdninstagram.com/v/t51.82787-19/590420429_18550963456014080_6118536616993181808_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby4xMDgwLmV4cGVyaW1lbnRhbCJ9&_nc_ht=scontent-mia5-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gGUTxd2U1y2NOj0rJ1jE0MXplOi-ZKGxXEC4uLC3iHRSDOIZhaKdcDpKzJzHaZ1Hgs&_nc_ohc=VJ_qPIifh0YQ7kNvwETMNuv&_nc_gid=eJhda8SyHI_jBRWI_7cIIQ&edm=ACWDqb8BAAAA&ccb=7-5&oh=00_AQCyKBU3ATcGrO9gfk9LBMdtIzZNcAHsL1W_uWQu97l8mQ&oe=6A565EDF&_nc_sid=ee9879"}, "is_covered": false, "private_reply_status": 0, "text_translation": "Jampidsus Febrie Adriansyah admits that the house in Sentul, Bogor, West Java (Jabar) area, which was raided by the police in connection with three corruption cases was his private house. 74 kg of gold and hundreds of billions of rupiah were found in the house.\n\n\"The second, about Sentul's house, it is indeed a private house of Jampidsus that has been around for a long time. It can be seen how the ownership is from the beginning,\" Febrie said during a press meeting at the Bundar building, Kejagung, Kebayoran Baru, South Jakarta, Friday (10/7/2026).\n\nFebrie said all tens of kilograms of gold bars and hundreds of billions of rupiahs belong to their owners. However, Febrie did not indirectly say who is the owner of the gold bars and hundreds of billions of rupees.\n\nRead full news only at detik.com !\n\n Video: Yumna Khan \n Creator: Putri \n\n #detikcom #korupsi #jampidsus #febrieadriansyah"}, "comment_count": 3432, "comment_likes_enabled": true, "comment_inform_treatment": {"action_type": null, "should_have_inform_treatment": false, "text": "", "url": null}, "is_photo_comments_composer_enabled_for_author": false, "hide_view_all_comment_entrypoint": false, "is_comments_gif_composer_enabled": false, "locations": [], "play_count": 582784, "ig_play_count": 582784, "shop_routing_user_id": null, "featured_products": [], "are_remixes_crosspostable": true, "is_eligible_for_autodub": false, "is_eligible_for_autodub_upsell": false, "video_sticker_locales": [], "has_audio": true, "video_duration": 53.599998474121094, "is_dash_eligible": 1, "video_versions": [{"bandwidth": 620179, "height": 1280, "id": "1709632093595309v", "type": 101, "url": "https://scontent-mia5-2.cdninstagram.com/o1/v/t2/f2/m86/AQMphr-F7AWIJFcRNQGpyWtgNEVLyEE_Jt7WTquLvoO-CUbUBnkKSs3VbbvhZ_bzX4NKgeO4iS2naD_QINRB_p3ftRgXdlI5K3KpqHQ.mp4?_nc_cat=100&_nc_sid=5e9851&_nc_ht=scontent-mia5-2.cdninstagram.com&_nc_ohc=CxlAgEZ8sEAQ7kNvwE4Vhz2&efg=eyJ2ZW5jb2RlX3RhZyI6Inhwdl9wcm9ncmVzc2l2ZS5JTlNUQUdSQU0uQ0xJUFMuQzMuNzIwLmRhc2hfYmFzZWxpbmVfMV92MSIsInhwdl9hc3NldF9pZCI6MTcwOTYzMTU4MzU5NTM2MCwiYXNzZXRfYWdlX2RheXMiOjAsInZpX3VzZWNhc2VfaWQiOjEwMDk5LCJkdXJhdGlvbl9zIjo1MywidXJsZ2VuX3NvdXJjZSI6Ind3dyJ9&ccb=17-1&vs=fc6977d2ddef2b8f&_nc_&_nc_gid=eJhda8SyHI_jBRWI_7cIIQ&_nc_ss=7a22e&_nc_zt=28&oh=00_AQBQ3gw97BDX38G523xCdokGAdZ1BRWwux6zKzlgCsi3zg&oe=6A5276D9", "url_expiration_timestamp_us": null, "width": 720, "fallback": null}, {"bandwidth": 620179, "height": 1280, "id": "1709632093595309v", "type": 102, "url": "https://scontent-mia5-2.cdninstagram.com/o1/v/t2/f2/m86/AQMphr-F7AWI