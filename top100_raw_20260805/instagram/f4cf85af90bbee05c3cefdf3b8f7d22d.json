ction_settings": null}, "like_count": 38299, "has_liked": false, "hidden_likes_string_variant": -1, "can_viewer_save": true, "caption": {"bit_flags": 0, "created_at": 1783821675, "created_at_utc": 1783821675, "did_report_as_spam": false, "is_ranked_comment": false, "pk": "17941678809256403", "share_enabled": false, "content_type": "comment", "media_id": "3939303932132497575", "status": "Active", "type": 1, "user_id": "1994292927", "strong_id__": "17941678809256403", "text": "Momen pilu dialami seorang wanita yang akhirnya memberanikan diri untuk memberi tahu kedua orang tuanya bahwa salah satu matanya telah mengalami kebutaan. Selama dua bulan, ia memilih memendam kondisi tersebut seorang diri.\n\nTangisnya pun pecah saat akhirnya menceritakan kondisi itu. Sang ayah tampak memeluk putrinya untuk memberikan ketenangan, sementara sang ibu tak kuasa menahan air mata mendengar pengakuan sang anak.\n\nPelukan sang ayah dan tangis sang ibu menjadi wujud kasih sayang serta dukungan bagi putrinya dalam menghadapi cobaan tersebut.\n\nVideo: TikTok @divaa.astriii\n\n[Baca berita dan informasi menarik lainnya hanya di www.indozone.id]", "user": {"pk": "1994292927", "pk_id": "1994292927", "id": "1994292927", "is_unpublished": false, "fbid_v2": "17841402067819286", "strong_id__": "1994292927", "username": "indozone.id", "full_name": "INDOZONE - #KAMUHARUSTAU", "is_private": false, "is_verified": true, "profile_pic_id": "3018320956885713174_1994292927", "profile_pic_url": "https://scontent-den2-1.cdninstagram.com/v/t51.2885-19/326005972_139552698946478_467721743645263209_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby4xMDgwLmMyIn0&_nc_ht=scontent-den2-1.cdninstagram.com&_nc_cat=1&_nc_oc=Q6cZ2gG5mRBfG8aVfKARRt7t5ryNi_afZgU8PdUX4BtFUGreBjAs3iatJsnYjLcT_PkdPy8&_nc_ohc=_th2p0xd9GQQ7kNvwEWQsgb&_nc_gid=YJzKK2w_5yjCU1lmNoDWIg&edm=ACWDqb8BAAAA&ccb=7-5&oh=00_AQDOgXYa-EqUAjCDXA4VKs3_RKyy9FZKFlIUNfuozaBAWg&oe=6A592280&_nc_sid=ee9879"}, "is_covered": false, "private_reply_status": 0, "text_translation": "The painful moment a woman had who finally had the courage to tell her parents that one of her eyes had gone blind. For two months, he chose to avenge the condition himself.\n\nHe cried when he finally narrated the condition. The father seemed to hug his daughter to give her peace, while the mother could not hold back her tears listening to the child's confession.\n\nThe father's hug and the mother's cry become a form of love and support for her daughter in facing the ordeal.\n\n Video: TikTok @divaa.astriii \n\n[Read more interesting news and information only at www.indozone.id ]"}, "comment_count": 477, "comment_likes_enabled": true, "commenting_disabled_for_viewer": true, "comment_inform_treatment": {"action_type": null, "should_have_inform_treatment": false, "text": "", "url": null}, "is_photo_comments_composer_enabled_for_author": false, "hide_view_all_comment_entrypoint": false, "is_comments_gif_composer_enabled": false, "locations": [], "play_count": 994166, "ig_play_count": 994166, "shop_routing_user_id": null, "featured_products": [], "are_remixes_crosspostable": true, "is_eligible_for_autodub": false, "is_eligible_for_autodub_upsell": false, "video_sticker_locales": [], "has_audio": true, "video_duration": 60.76599884033203, "is_dash_eligible": 1, "video_versions": [{"bandwidth": 405510, "height": 1280, "id": "18562284469068928v", "type": 101, "url": "https://scontent-den2-1.cdninstagram.com/o1/v/t2/f2/m86/AQMRCS2Nmz68EWmH_-IxdtqgkbNjaPgsYCOHWFqCNm0pt9XA0-k34qalGAZzmArHhRDzSJKXtFxfsDo8rLvM3FwQGfukOvs23vraUdo.mp4?_nc_cat=108&_nc_sid=5e9851&_nc_ht=scontent-den2-1.cdninstagram.com&_nc_ohc=He5EkzAbW-gQ7kNvwFBRo83&efg=eyJ2ZW5jb2RlX3RhZyI6Inhwdl9wcm9ncmVzc2l2ZS5JTlNUQUdSQU0uQ0xJUFMuQzMuNzIwLmRhc2hfYmFzZWxpbmVfMV92MSIsInhwdl9hc3NldF9pZCI6MTg1NjIyODQzMTYwNjg5MjgsImFzc2V0X2FnZV9kYXlzIjowLCJ2aV91c2VjYXNlX2lkIjoxMDA5OSwiZHVyYXRpb25fcyI6NjAsInVybGdlbl9zb3VyY2UiOiJ3d3cifQ%3D%3D&ccb=17-1&vs=621f64c189707b72&_nc_&_nc_gid=YJ