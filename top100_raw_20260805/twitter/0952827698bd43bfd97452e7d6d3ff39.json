rcaya"}, "profile_description_language": "in", "profile_image_shape": "Circle", "relationship_perspectives": {"blocked_by": false, "blocking": false, "followed_by": false, "following": false, "live_following": false, "muting": false}, "rest_id": "23343960", "super_follow_eligible": false, "super_followed_by": false, "super_following": false, "verification": {"verified": false}}}}, "edit_control": {"edit_tweet_ids": ["2080956415569793519"], "editable_until_msecs": "1784977246000", "edits_remaining": "5", "is_edit_eligible": true}, "grok_analysis_button": true, "grok_annotations": {"is_image_editable_by_grok": false}, "grok_translated_post_with_availability": {"data": {"associated_data": {}, "destination_language": "en", "entities": {"hashtags": [{"indices": [1123, 1134], "text": "WhiteTiger"}, {"indices": [1135, 1144], "text": "Wildlife"}, {"indices": [1145, 1154], "text": "Semarang"}], "symbols": [], "urls": [], "user_mentions": []}, "preview_translation": "Anggun, the white tiger who became an icon of Semarang Zoo, died after being transferred to Medan.\n\nAccording to a viral narrative on social media, Anggun died two days after being sent to Medan, sparking suspicions of an anesthesia procedure error.\n\nThe death, which reportedly", "source_language": "in", "translation": "Anggun, the white tiger who became an icon of Semarang Zoo, died after being transferred to Medan.\n\nAccording to a viral narrative on social media, Anggun died two days after being sent to Medan, sparking suspicions of an anesthesia procedure error.\n\nThe death, which reportedly occurred two days after the transfer, has drawn public scrutiny due to suspicions of an anesthesia procedure error.\n\nIn response, Semarang Mayor Agustina Wilujeng Pramestuti stated that the city government will investigate the cause of Anggun's death, including allegations of an anesthesia procedure error.\n\n\"We will investigate because this is negligence on the part of Semarang Zoo,\" she said on Friday (24/7/2026).\n\nAgustina said the investigation results are expected to confirm the cause of Anggun's death while serving as material for evaluation to prevent similar incidents in the management and care of animals.\n\nTo date, the city government is still awaiting a complete report from Semarang Zoo's management regarding the chronology and exact cause of Anggun's death.\n\n🎥: IG @/dinaskegelapan_kotasemarang\n\nSource: Tribun Banyumas\n\n~R #WhiteTiger #Wildlife #Semarang"}, "is_available": true}, "is_translatable": true, "legacy": {"bookmark_count": 100, "bookmarked": false, "conversation_id_str": "2080956415569793519", "created_at": "Sat Jul 25 10:00:46 +0000 2026", "display_text_range": [0, 275], "entities": {"media": [{"additional_media_info": {"monetizable": false}, "display_url": "pic.x.com/MSbaGhaSgS", "expanded_url": "https://x.com/kompascom/status/2080956415569793519/video/1", "ext_media_availability": {"status": "Available"}, "id_str": "2080954271080886272", "indices": [276, 299], "media_key": "13_2080954271080886272", "media_results": {"result": {"media_key": "13_2080954271080886272"}}, "media_url_https": "https://pbs.twimg.com/amplify_video_thumb/2080954271080886272/img/z3xpWaZ8Mzw7kRqj.jpg", "original_info": {"focus_rects": [], "height": 1920, "width": 1080}, "sizes": {"large": {"h": 1920, "resize": "fit", "w": 1080}, "medium": {"h": 1200, "resize": "fit", "w": 675}, "small": {"h": 680, "resize": "fit", "w": 383}, "thumb": {"h": 150, "resize": "crop", "w": 150}}, "type": "video", "url": "https://t.co/MSbaGhaSgS", "video_info": {"aspect_ratio": [9, 16], "duration_millis": 10843, "variants": [{"content_type": "application/x-mpegURL", "url": "https://video.twimg.com/amplify_video/2080954271080886272/pl/1n9Iy3s1SVxyqepZ.m3u8?tag=29&v=cfc"}, {"bitrate": 632000, "content_type": "video/mp4", "url": "https://video.twimg.com/amplify_video/2080954271080886272/vid/avc1/320x568/KTJ9lI4N8siNKr6L.mp4?tag=29"}, {"bitrate": 950000, "content_type": "video/mp4", "url": "http