tag=29"}, {"bitrate": 10368000, "content_type": "video/mp4", "url": "https://video.twimg.com/amplify_video/2080954271080886272/vid/avc1/1080x1920/lJa2FjNG3K9jEgNU.mp4?tag=29"}]}}]}, "favorite_count": 2873, "favorited": false, "full_text": "Anggun, harimau putih yang menjadi ikon Semarang Zoo, mati setelah dipindahkan ke Medan.\n\nMenurut narasi yang viral di media sosial, Anggun meninggal dua hari setelah dikirim ke Medan sehingga memicu dugaan kesalahan prosedur anestesi.\n\nKematian yang disebut terjadi dua hari https://t.co/MSbaGhaSgS", "id_str": "2080956415569793519", "is_quote_status": false, "lang": "in", "possibly_sensitive": false, "possibly_sensitive_editable": true, "quote_count": 138, "reply_count": 100, "retweet_count": 888, "retweeted": false, "user_id_str": "23343960"}, "note_tweet": {"is_expandable": true, "note_tweet_results": {"result": {"entity_set": {"hashtags": [{"indices": [1059, 1072], "text": "HarimauPutih"}, {"indices": [1073, 1079], "text": "Satwa"}, {"indices": [1080, 1089], "text": "Semarang"}], "smarttags": [], "symbols": [], "timestamps": [], "urls": [], "user_mentions": []}, "id": "Tm90ZVR3ZWV0OjIwODA5NTY0MTU0MTg3Njk0MDg=", "richtext": {"richtext_tags": []}, "text": "Anggun, harimau putih yang menjadi ikon Semarang Zoo, mati setelah dipindahkan ke Medan.\n\nMenurut narasi yang viral di media sosial, Anggun meninggal dua hari setelah dikirim ke Medan sehingga memicu dugaan kesalahan prosedur anestesi.\n\nKematian yang disebut terjadi dua hari setelah pemindahan itu memicu sorotan publik karena diduga berkaitan dengan kesalahan prosedur anestesi.\n\nMenanggapi hal itu, Wali Kota Semarang Agustina Wilujeng Pramestuti mengatakan Pemkot akan menyelidiki penyebab kematian Anggun, termasuk dugaan adanya kesalahan prosedur anestesi.\n\n\"Kami akan selidiki karena itu adalah kelalaian dari Semarang Zoo,\" ujarnya, Jumat (24/7/2026).\n\nAgustina menyebut hasil penyelidikan diharapkan dapat memastikan penyebab kematian Anggun sekaligus menjadi bahan evaluasi agar kejadian serupa tidak terulang dalam pengelolaan dan perawatan satwa.\n\nHingga kini, Pemkot masih menunggu laporan lengkap dari pengelola Semarang Zoo terkait kronologi dan penyebab pasti kematian Anggun.\n\n🎥: IG @/dinaskegelapan_kotasemarang\n\nSumber: Tribun Banyumas\n\n~R #HarimauPutih #Satwa #Semarang"}}}, "quick_promote_eligibility": {"eligibility": "IneligibleNotVerified"}, "rest_id": "2080956415569793519", "source": "<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>", "unmention_data": {}, "views": {"count": "148905", "state": "EnabledWithCount"}}