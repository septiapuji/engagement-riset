: 0, "y": 751}, {"h": 1200, "w": 1200, "x": 0, "y": 300}, {"h": 1368, "w": 1200, "x": 0, "y": 132}, {"h": 1500, "w": 750, "x": 37, "y": 0}, {"h": 1500, "w": 1200, "x": 0, "y": 0}], "height": 1500, "width": 1200}, "sizes": {"large": {"h": 1500, "resize": "fit", "w": 1200}, "medium": {"h": 1200, "resize": "fit", "w": 960}, "small": {"h": 680, "resize": "fit", "w": 544}, "thumb": {"h": 150, "resize": "crop", "w": 150}}, "type": "photo", "url": "https://t.co/jxXXnhQF4Z"}]}, "favorite_count": 63, "favorited": false, "full_text": "Polda Metro Jaya (PMJ) tengah menyelidiki penyebab kematian misterius seorang pria bernama Sutrimo di daerah Jakarta Selatan.\n\nAwalnya, Sutrimo ditemukan tidak sadarkan diri di halaman Klinik Mordent, Kebayoran Baru, Jakarta Selatan, pada Kamis (23/7). Korban kemudian dibawa https://t.co/jxXXnhQF4Z", "id_str": "2081381951018274980", "is_quote_status": false, "lang": "in", "possibly_sensitive": false, "possibly_sensitive_editable": true, "quote_count": 0, "reply_count": 3, "retweet_count": 28, "retweeted": false, "user_id_str": "759692754985242625"}, "note_tweet": {"is_expandable": true, "note_tweet_results": {"result": {"entity_set": {"hashtags": [{"indices": [1209, 1232], "text": "bicarafaktalewatberita"}, {"indices": [1233, 1242], "text": "kumparan"}], "smarttags": [], "symbols": [], "urls": [], "user_mentions": []}, "id": "Tm90ZVR3ZWV0OjIwODEzODE5NTA4NDYzNDUyMTY=", "richtext": {"richtext_tags": []}, "text": "Polda Metro Jaya (PMJ) tengah menyelidiki penyebab kematian misterius seorang pria bernama Sutrimo di daerah Jakarta Selatan.\n\nAwalnya, Sutrimo ditemukan tidak sadarkan diri di halaman Klinik Mordent, Kebayoran Baru, Jakarta Selatan, pada Kamis (23/7). Korban kemudian dibawa menggunakan ambulans ke RS Muhammadiyah Taman Puring. Namun, dia dinyatakan telah meninggal dunia saat tiba di rumah sakit.\n\nKabid Humas Polda Metro Jaya Kombes Pol Budi Hermanto mengatakan proses penyelidikan masih berlangsung sehingga polisi belum dapat menyimpulkan penyebab kematian korban. Sejumlah pihak dimintai keterangannya untuk mengungkap penyebab pastinya.\n\nPenyelidik tengah mengumpulkan bahan keterangan serta melakukan klarifikasi terhadap pihak keluarga, pengemudi ambulans, petugas rumah sakit, dan pihak lain yang mengetahui peristiwa tersebut. \n\nSelain itu, rekam medis, riwayat pemesanan ambulans, lokasi awal ditemukannya almarhum, serta informasi lain yang berkaitan juga sedang didalami.\n\n📸: Dok. Shutterstock.\n\nBaca selengkapnya dengan klik link di bio. Cari tahu berita update lainnya dengan download aplikasi kumparan di App Store atau Google Play.⁠\n\n📝: newsupdate | update | news | oneliner | R025 | E164\n\n#bicarafaktalewatberita #kumparan"}}}, "quick_promote_eligibility": {"eligibility": "IneligibleNotVerified"}, "rest_id": "2081381951018274980", "source": "<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>", "unmention_data": {}, "views": {"count": "18333", "state": "EnabledWithCount"}}